% Définition des en-têtes et pieds de page
\fancyhead[L]{\small\sffamily\bfseries\color{colPrimary}\nouppercase{\leftmark}}
\fancyhead[R]{\small\sffamily\color{slate600}\thefiliere\ -- \thematiere}
\fancyfoot[L]{\footnotesize\sffamily\color{slate500}Livret Pédagogique \theannee}
\fancyfoot[C]{\small\sffamily\bfseries\color{colPrimary}\thepage}
\fancyfoot[R]{\footnotesize\sffamily\color{slate500}\thelycee}
\renewcommand{\headrulewidth}{0.6pt}
\renewcommand{\footrulewidth}{0.4pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{colSecondary}\leaders\hrule height \headrulewidth\hfill}}
\renewcommand{\footrule}{\hbox to\headwidth{\color{slate300}\leaders\hrule height \footrulewidth\hfill}}

% Style pour les pages de chapitre
\fancypagestyle{plain}{
    \fancyhf{}
