% ==============================================================================
% 4. PACKAGES MATHS, PHYSIQUE, SYMBOLES & TABLEAUX
% ==============================================================================
\RequirePackage{amsmath,amssymb,amsfonts,mathrsfs,mathtools}
\RequirePackage{siunitx}
\sisetup{
    locale = FR,
    output-decimal-marker = {,},
    group-separator = {\,},
    inter-unit-product = \ensuremath{{}\cdot{}}
}
\RequirePackage{tabularx}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{enumitem}
\setlist[itemize]{label=\textcolor{colSecondary}{\small$\blacktriangleright$}, leftmargin=1.5em, itemsep=2pt}
\setlist[enumerate]{label=\textcolor{colPrimary}{\textbf{\arabic*.}}, leftmargin=1.5em, itemsep=2pt}
\RequirePackage{pifont}

% ==============================================================================
% 5. TIKZ & TCOLORBOX (DESIGN DES BLOCS ÉDITORIAUX)
% ==============================================================================
\RequirePackage{tikz}
\usetikzlibrary{calc,shapes,positioning,patterns,arrows.meta}
\RequirePackage[many]{tcolorbox}
\tcbuselibrary{skins,breakable,listings,theorems}

% --- Badge / Étiquette ---
\newcommand{\badge}[2][slate700]{%
    \tcbox[
        on line,
        arc=4pt,
        colback=#1!12,
        colframe=#1!40,
        boxrule=0.5pt,
        top=1.5pt,bottom=1.5pt,left=4pt,right=4pt,
        fontupper=\sffamily\bfseries\scriptsize\color{#1}
    ]{#2}%
}

% --- Style de base pour les boîtes de cours ---
\tcbset{
    coursBoxStyle/.style={
        enhanced,
        breakable,
        arc=6pt,
        boxrule=0.8pt,
        left=10pt,
        right=10pt,
        top=8pt,
        bottom=8pt,
        shadow={1mm}{-1mm}{0mm}{black!5}
    }
}

% 1. Définition
\newtcolorbox{cadredef}[1][]{
    coursBoxStyle,
    colback=colDefBg,
    colframe=colDef,
    coltitle=colDef,
    fonttitle=\sffamily\bfseries\normalsize,
    title={\faBookOpen\ \textbf{DÉFINITION} \ifstrempty{#1}{}{: #1}},
    attach boxed title to top left={yshift=-2mm, xshift=4mm},
    boxed title style={colback=colDefBg, boxrule=0pt}
}

% 2. Propriété / Théorème
\newtcolorbox{cadreprop}[1][]{
    coursBoxStyle,
    colback=colPropBg,
    colframe=colProp,
    coltitle=colProp!80!black,
    fonttitle=\sffamily\bfseries\normalsize,
    title={\faCheckCircle\ \textbf{PROPRIÉTÉ} \ifstrempty{#1}{}{: #1}},
    attach boxed title to top left={yshift=-2mm, xshift=4mm},
    boxed title style={colback=colPropBg, boxrule=0pt}
}

% 3. Méthode / Savoir-faire
\newtcolorbox{cadremethode}[1][]{
    coursBoxStyle,
    colback=colMethBg,
    colframe=colMeth,
    coltitle=colMeth!80!black,
    fonttitle=\sffamily\bfseries\normalsize,
    title={\faTools\ \textbf{MÉTHODE} \ifstrempty{#1}{}{: #1}},
    attach boxed title to top left={yshift=-2mm, xshift=4mm},
    boxed title style={colback=colMethBg, boxrule=0pt}
}

% 4. Exemple résolu
\newtcolorbox{cadreexemple}[1][]{
    coursBoxStyle,
    colback=colExemBg,
    colframe=colExem,
    coltitle=colExem!80!black,
    fonttitle=\sffamily\bfseries\normalsize,
    title={\faLightbulb\ \textbf{EXEMPLE} \ifstrempty{#1}{}{: #1}},
    attach boxed title to top left={yshift=-2mm, xshift=4mm},
    boxed title style={colback=colExemBg, boxrule=0pt}
}

% 5. Remarque
\newtcolorbox{cadreremarque}[1][]{
    coursBoxStyle,
    colback=colRemBg,
    colframe=colRem,
    coltitle=colRem!80!black,
    fonttitle=\sffamily\bfseries\normalsize,
    title={\faInfoCircle\ \textbf{REMARQUE} \ifstrempty{#1}{}{: #1}},
    attach boxed title to top left={yshift=-2mm, xshift=4mm},
    boxed title style={colback=colRemBg, boxrule=0pt}
}

% 6. Piège / Attention
\newtcolorbox{cadrepiege}[1][]{
    coursBoxStyle,
    colback=colPiegeBg,
    colframe=colPiege,
    coltitle=colPiege!90!black,
    fonttitle=\sffamily\bfseries\normalsize,
    title={\faExclamationTriangle\ \textbf{ATTENTION / PIÈGE FRÉQUENT} \ifstrempty{#1}{}{: #1}},
    attach boxed title to top left={yshift=-2mm, xshift=4mm},
    boxed title style={colback=colPiegeBg, boxrule=0pt}
}

% 7. L'essentiel à retenir
\newtcolorbox{cadreretenu}[1][L'Essentiel à Retenir]{
    enhanced,
    breakable,
    arc=8pt,
    colback=slate900,
    colframe=colSecondary,
    boxrule=1.5pt,
    coltext=white,
    fonttitle=\sffamily\bfseries\large\color{colSecondary},
    title={\faStar\ #1},
    top=10pt, bottom=10pt, left=12pt, right=12pt
}

% 8. Activité d'Introduction / Investigation
\newtcolorbox{activite}[1]{
    enhanced,
    breakable,
    arc=6pt,
    colback=slate50,
    colframe=slate700,
    boxrule=1pt,
    fonttitle=\sffamily\bfseries\large\color{white},
    coltitle=white,
    title={\faSearch\ Activité d'Investigation : #1},
    attach boxed title to top left={yshift=-3mm, xshift=4mm},
    boxed title style={colback=slate800, arc=4pt, boxrule=0pt},
    top=10pt, bottom=8pt, left=10pt, right=10pt
}

% 9. Exercice de TD
\newcounter{numexo}[chapter]
\renewcommand{\thenumexo}{\arabic{numexo}}

\newenvironment{exercice}[3][]{%
    \refstepcounter{numexo}%
    \begin{tcolorbox}[
        enhanced,
        breakable,
        arc=6pt,
        boxrule=0.8pt,
        colback=white,
        colframe=colExo,
        coltitle=colExo!90!black,
        fonttitle=\sffamily\bfseries\normalsize,
        title={%
            \textbf{Exercice \thenumexo} \ifstrempty{#3}{}{\ -- #3}%
            \hfill \ifstrempty{#1}{}{\badge[colExo]{#1}}%
            \ifstrempty{#2}{}{\ \badge[slate600]{#2}}%
        },
        top=8pt, bottom=8pt, left=10pt, right=10pt
    ]%
}{%
    \end{tcolorbox}%
}

% 10. Sujet Brevet / DNB Pro
\newcounter{numdnb}[chapter]
\newenvironment{sujetdnb}[3][]{%
    \refstepcounter{numdnb}%
    \begin{tcolorbox}[
        enhanced,
        breakable,
        arc=6pt,
        boxrule=1pt,
        colback=colDNBBg,
        colframe=colDNB,
        fonttitle=\sffamily\bfseries\normalsize\color{colDNB!90!black},
        title={%
            \faGraduationCap\ \textbf{Sujet DNB Pro \thenumdnb} : #3%
            \hfill \ifstrempty{#1}{}{\badge[colDNB]{#1}}%
            \ifstrempty{#2}{}{\ \badge[slate700]{#2}}%
        },
        top=8pt, bottom=8pt, left=10pt, right=10pt
    ]%
}{%
    \end{tcolorbox}%
}

% 11. TP TICE / Tableur / Informatique
\newtcolorbox{tpinfo}[2][]{
    enhanced,
    breakable,
    arc=6pt,
    boxrule=1pt,
    colback=colTPBg,
    colframe=colTP,
    fonttitle=\sffamily\bfseries\normalsize\color{colTP!90!black},
    title={%
        \faLaptopCode\ \textbf{TP TICE} : #2%
        \hfill \ifstrempty{#1}{}{\badge[colTP]{#1}}%
    },
    top=8pt, bottom=8pt, left=10pt, right=10pt
}

% 12. Solution / Corrigé
\newtcolorbox{solution}[1][Corrigé \& Démarche]{
    enhanced,
    breakable,
    arc=4pt,
    boxrule=0.5pt,
    colback=slate100,
    colframe=slate400,
    fonttitle=\sffamily\bfseries\small\color{slate700},
    title={\faCheck\ #1},
    top=6pt, bottom=6pt, left=8pt, right=8pt
}

% 13. Questions Flash / Automatismes
\newtcolorbox{automatisme}[1][Questions Flash / Automatismes]{
    enhanced,
    breakable,
    arc=6pt,
    boxrule=1pt,
    colback=colExemBg,
    colframe=colExem,
    fonttitle=\sffamily\bfseries\normalsize\color{colExem!90!black},
    title={\faBolt\ \textbf{#1}},
    top=8pt, bottom=8pt, left=10pt, right=10pt
}

% ==============================================================================
% 6. OUTILS DE MISE EN PAGE & RÉDACTION ÉLÈVE
% ==============================================================================
% Lignes d'écriture pointillées
\RequirePackage{multido}
\newcommand{\lignesreponse}[1][3]{%
    \vspace{2mm}%
    \multido{\i=1+1}{#1}{%
        \noindent\makebox[\linewidth]{\dotfill}\\[1.5mm]%
    }%
    \vspace{-1mm}%
}

% Quadrillage 5mm pour tracé
\newcommand{\quadrillage}[1][3cm]{%
    \vspace{2mm}%
    \noindent\begin{tikzpicture}
        \draw[step=5mm, slate300, line width=0.3pt] (0,0) grid (\linewidth, #1);
    \end{tikzpicture}%
    \vspace{2mm}%
}

% Encadré pour résultat final
\newcommand{\repbox}[1]{%
    \tcbox[
        on line,
        arc=3pt,
        colback=slate100,
        colframe=colPrimary,
        boxrule=1pt,
        top=2pt,bottom=2pt,left=6pt,right=6pt,
        fontupper=\bfseries\color{colPrimary}
    ]{#1}%
}

% Pointillés à compléter dans le texte
\newcommand{\pointille}[1][2cm]{\makebox[#1]{\dotfill}}

% ==============================================================================
% 7. FORMAT DES TITRES ET SECTIONS
% ==============================================================================
\RequirePackage{titlesec}

% Format des chapitres
\titleformat{\chapter}[display]
{\normalfont\sffamily\raggedright}
{
    \begin{tikzpicture}
        \node[fill=colPrimary, text=white, rounded corners=6pt, inner sep=8pt, font=\Large\bfseries] {
            CHAPITRE \thechapter
        };
    \end{tikzpicture}
}
{8pt}
{\fontsize{22}{26}\selectfont\bfseries\color{navy900}}
[\vspace{4pt}{\color{colSecondary}\hrule height 2pt}\vspace{12pt}]

% Format des sections
\titleformat{\section}
{\normalfont\Large\sffamily\bfseries\color{colPrimary}}
{\color{colSecondary}\thesection.}{8pt}{}
[\vspace{-4pt}{\color{slate200}\hrule height 0.6pt}\vspace{6pt}]

% Format des sous-sections
\titleformat{\subsection}
{\normalfont\large\sffamily\bfseries\color{slate800}}
{\textcolor{colSecondary}{$\blacktriangleright$}\ \thesubsection}{6pt}{}

