% ==============================================================================
% 1. ENSEMBLES ET SYMBOLES MATHÉMATIQUES
% ==============================================================================
\providecommand{\N}{\mathbb{N}}
\providecommand{\Z}{\mathbb{Z}}
\providecommand{\D}{\mathbb{D}}
\providecommand{\Q}{\mathbb{Q}}
\providecommand{\R}{\mathbb{R}}
\providecommand{\C}{\mathbb{C}}

\providecommand{\intervalle}[2]{[#1\,;\,#2]}
\providecommand{\intervallefo}[2]{[#1\,;\,#2[}
\providecommand{\intervalleof}[2]{]#1\,;\,#2]}
\providecommand{\intervalleoo}[2]{]#1\,;\,#2[}

% Notations des vecteurs
\providecommand{\vect}[1]{\overrightarrow{#1}}
\providecommand{\vcoords}[2]{\begin{pmatrix} #1 \\ #2 \end{pmatrix}}
\providecommand{\vcoordsz}[3]{\begin{pmatrix} #1 \\ #2 \\ #3 \end{pmatrix}}

% Probabilités
\providecommand{\Proba}[1]{\mathbb{P}\left(#1\right)}
\providecommand{\ProbaCond}[2]{\mathbb{P}_{#2}\left(#1\right)}

% ==============================================================================
% 2. SYMBOLES D'OPÉRATIONS ET D'ÉVALUATION
% ==============================================================================
\providecommand{\x}{\times}
\providecommand{\ssi}{\Longleftrightarrow}
\providecommand{\donc}{\Longrightarrow}
\providecommand{\equivalent}{\iff}

% Degré et symbole euro
\providecommand{\degre}{^{\circ}}
\providecommand{\euro}{\text{ \euro}}

% Compétences du référentiel (Grille nationale Bac Pro / DNB Pro)
\providecommand{\capSApproprier}{\badge[colPrimary]{C1 $\cdot$ S'approprier}}
\providecommand{\capAnalyser}{\badge[colSecondary]{C2 $\cdot$ Analyser/Raisonner}}
\providecommand{\capRealiser}{\badge[colProp]{C3 $\cdot$ Réaliser}}
\providecommand{\capValider}{\badge[colExem]{C4 $\cdot$ Valider}}
\providecommand{\capCommuniquer}{\badge[colMeth]{C5 $\cdot$ Communiquer}}

% ==============================================================================
% 3. DESSIN ET GRAPHES RAPIDES TIKZ
% ==============================================================================
% Repère orthonormé standard
\providecommand{\repereOrtho}[4]{% [xmin, xmax, ymin, ymax]
    \draw[step=1cm, slate200, very thin] (#1,#3) grid (#2,#4);
    \draw[thick, ->, >=stealth, slate700] (#1,0) -- (#2,0) node[right] {\footnotesize $x$};
    \draw[thick, ->, >=stealth, slate700] (0,#3) -- (0,#4) node[above] {\footnotesize $y$};
    \node[below left, font=\footnotesize] at (0,0) {$O$};
    \draw[thick] (1,0.1) -- (1,-0.1) node[below, font=\footnotesize] {$1$};
    \draw[thick] (0.1,1) -- (-0.1,1) node[left, font=\footnotesize] {$1$};
}

